# Firebase configuration values for local generation.
# Copy this file to .env and fill in your own values.

ATTENDANCE_USE_FIRESTORE=true
ATTENDANCE_FIREBASE_API_KEY=YOUR_API_KEY
ATTENDANCE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
ATTENDANCE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
ATTENDANCE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
ATTENDANCE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
ATTENDANCE_FIREBASE_APP_ID=YOUR_APP_ID
ATTENDANCE_ADMIN_PASSCODE=admin123
