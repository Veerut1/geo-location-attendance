rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validAttendanceId(attendanceId) {
      return attendanceId == request.resource.data.employeeId + "_" + request.resource.data.date;
    }

    function hasOnlyCheckInFields() {
      return request.resource.data.keys().hasOnly([
        "employeeId",
        "employeeName",
        "date",
        "checkInTime",
        "latitude",
        "longitude",
        "accuracyMeters",
        "status",
        "officeId",
        "officeName",
        "distanceFromOfficeMeters",
        "deviceType",
        "browser",
        "createdAt"
      ]);
    }

    function hasRequiredCheckInFields() {
      return request.resource.data.keys().hasAll([
        "employeeId",
        "employeeName",
        "date",
        "checkInTime",
        "latitude",
        "longitude",
        "accuracyMeters",
        "status",
        "officeId",
        "officeName",
        "distanceFromOfficeMeters",
        "deviceType",
        "browser",
        "createdAt"
      ]);
    }

    function isValidDate() {
      return request.resource.data.date.matches("^\\d{4}-\\d{2}-\\d{2}$");
    }

    function isValidLocation() {
      return request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.accuracyMeters is number
        && request.resource.data.distanceFromOfficeMeters is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.accuracyMeters > 0
        && request.resource.data.accuracyMeters <= 100;
    }

    function hasValidTextFields() {
      return request.resource.data.employeeId is string
        && request.resource.data.employeeName is string
        && request.resource.data.officeId is string
        && request.resource.data.officeName is string
        && request.resource.data.deviceType is string
        && request.resource.data.browser is string;
    }

    function isValidStatus() {
      return request.resource.data.status in ["OFFICE", "REMOTE"];
    }

    function isValidCheckInCreate(attendanceId) {
      return hasOnlyCheckInFields()
        && hasRequiredCheckInFields()
        && validAttendanceId(attendanceId)
        && isValidDate()
        && isValidLocation()
        && isValidStatus()
        && hasValidTextFields()
        && request.resource.data.checkInTime == request.time
        && request.resource.data.createdAt == request.time;
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/attendance/$(attendanceId))
        && isValidCheckInCreate(attendanceId);
      allow update, delete: if false;
    }
  }
}
